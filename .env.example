# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-here-change-in-production
TEACHER_PASSWORD=change-this-password-in-production

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database
# DB_PATH overrides DATABASE_URL. On Railway set DB_PATH=/app/data/feedny.db
# (volume mounted at /app/data) so data survives redeploys and restarts.
DATABASE_URL=sqlite:///./feedny.db
# DB_PATH=/app/data/feedny.db

# Admin class code (default: HOUSNI)
# ADMIN_CODE=HOUSNI

# CORS
ALLOWED_ORIGINS=*
